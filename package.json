{
  "name": "naysi-paylater",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Naysi — code-native Indonesian motion journalism, 1440×2560 at 90 fps",
  "scripts": {
    "dev": "remotion studio src/remotion/index.ts --port=3000 --ipv4",
    "prepare:browser": "node scripts/browser.mjs",
    "audio": "node scripts/audio.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "still": "node scripts/render.mjs --still",
    "render": "node scripts/render.mjs",
    "qc": "node scripts/qc.mjs",
    "timing": "tsx scripts/timing.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@remotion/cli": "4.0.543",
    "@remotion/fonts": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "@sparticuz/chromium": "153.0.0",
    "ffprobe-static": "3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
