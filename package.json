{
  "name": "naysi",
  "version": "1.0.0",
  "description": "NAYSI Shorts — 2K 90fps motion graphics dari kode (canvas + Remotion Studio)",
  "scripts": {
    "vo": "node scripts/prep-vo.mjs",
    "audio": "node scripts/audio.mjs",
    "stills": "node src/render.mjs --stills 3,12,26,38,47,60,75",
    "render": "node src/render.mjs --from 0 --to 7067 --preset superfast --crf 18 --out out/video.mp4",
    "build": "node scripts/build.mjs",
    "mux": "node scripts/mux.mjs",
    "studio": "remotion studio --port=3000 --host=0.0.0.0",
    "remotion:render": "remotion render src/remotion/index.js NaysiShort out/remotion.mp4 --concurrency=2",
    "align": "node scripts/align-cards.mjs",
    "audio:ep22": "VO_EP=ep22 node scripts/audio-ep22.mjs",
    "render:ep22": "bash scripts/render-ep22.sh",
    "audio:ep23": "VO_EP=ep23 node scripts/audio-ep23.mjs",
    "render:ep23": "bash scripts/render-ep23.sh",
    "audio:ep24": "VO_EP=ep24 node scripts/audio-ep24.mjs",
    "render:ep24": "bash scripts/render-ep24.sh",
    "audio:ep25": "VO_EP=ep25 node scripts/audio-ep25.mjs",
    "render:ep25": "bash scripts/render-ep25.sh",
    "audio:ep26": "VO_EP=ep26 node scripts/audio-ep26.mjs",
    "render:ep26": "bash scripts/render-ep26.sh",
    "audio:ep27": "VO_EP=ep27 node scripts/audio-ep27.mjs",
    "render:ep27": "bash scripts/render-ep27.sh",
    "audio:ep28": "VO_EP=ep28 node scripts/audio-ep28.mjs",
    "audio:ep29": "VO_EP=ep29 node scripts/audio-ep29.mjs",
    "render:ep28": "bash scripts/render-ep28.sh",
    "render:ep29": "bash scripts/render-ep29.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enovoid28-dot/YT-4-Naysi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/enovoid28-dot/YT-4-Naysi/issues"
  },
  "homepage": "https://github.com/enovoid28-dot/YT-4-Naysi#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@napi-rs/canvas": "1.1.1",
    "@remotion/cli": "4.0.544",
    "@remotion/player": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "topojson-client": "3.1.0",
    "wawoff2": "2.0.1",
    "world-atlas": "2.0.2"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.544"
  }
