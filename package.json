{
  "name": "cpi-naysi",
  "version": "1.0.0",
  "description": "CPI explainer \u2014 2K 90fps motion graphics built entirely in code",
  "scripts": {
    "vo": "node scripts/prep-vo.mjs",
    "audio": "node scripts/audio.mjs",
    "stills": "node src/render.mjs --stills 3,12,26,38,47,60,75",
    "render": "node src/render.mjs --from 0 --to 7067 --preset superfast --crf 18 --out out/video.mp4",
    "build": "node scripts/build.mjs",
    "mux": "node scripts/mux.mjs"
  },
